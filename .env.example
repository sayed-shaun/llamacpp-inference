# ============================================================
#  Copy this file to .env and edit for your setup:
#    cp .env.example .env
# ============================================================

# --- Model to download & serve (pulled from Hugging Face) ---
# HF_REPO: the repo id (user/model). Do NOT append a quant tag here.
# HF_FILE: the exact .gguf filename inside that repo (must match exactly).
HF_REPO=unsloth/gemma-4-E4B-it-GGUF
HF_FILE=gemma-4-E4B-it-UD-IQ2_M.gguf

# Only required for private / gated repos. Leave commented otherwise.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxx

# --- Server / runtime config ---
PORT=8080          # host port to expose
PARALLEL=4         # concurrent request slots
CTX_SIZE=4096      # total context, shared across slots (0 = model max)
NGL=99             # layers on GPU (99 = all) — used by cuda + vulkan, ignored on cpu
FLASH_ATTN=on      # on / off / auto — reduces KV-cache memory
THREADS=0          # cpu backend only: CPU threads (0 = auto-detect cores)

# --- Extra llama-server CLI flags ---
# "--no-mmproj" = text-only, skips multimodal projector (saves ~1.2 GB VRAM).
# Leave empty for full multimodal (image/audio) support.
EXTRA_ARGS=--no-mmproj
